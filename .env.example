# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. `.env.local` is gitignored — never commit it.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local Docker Postgres (matches docker-compose.yml, host port 5434).
DATABASE_URL="postgresql://dh:dh_local_dev@localhost:5434/digital_heroes"
# Production (Neon) looks like:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- App -------------------------------------------------------------------
# Public origin, used for Stripe redirects and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Stripe (test mode) ----------------------------------------------------
# Dashboard → Developers → API keys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Printed by: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Money -----------------------------------------------------------------
# ISO 4217 code. Must match your Stripe account's settlement currency,
# otherwise every charge takes a conversion path. All amounts are stored as
# integers in the minor unit (cents) to avoid floating-point drift.
NEXT_PUBLIC_CURRENCY="EUR"

# --- Seed ------------------------------------------------------------------
# Credentials created by `npm run db:seed`. Change before any public deploy.
SEED_ADMIN_EMAIL="admin@digitalheroes.test"
SEED_ADMIN_PASSWORD="Admin@12345"
SEED_USER_EMAIL="player@digitalheroes.test"
SEED_USER_PASSWORD="Player@12345"
